{
  "permissions": {
    "allow": [
      "Bash(rg:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(make verify-delta:*)",
      "Bash(make test-focused:*)",
      "Bash(make build-checker-debug)",
      "Bash(make coverage)",
      "Bash(make ownership-gate)",
      "Bash(make verify)",
      "Bash(bun scripts/verify-delta.mjs:*)",
      "Bash(bun scripts/dialect-manifests.mjs validate)",
      "Bash(bun run --cwd packages/cli test)",
      "Bash(bun run --cwd packages/wasm test)",
      "Bash(jq empty schema/typefacts-v1.schema.json schema/typefacts-codec-limits.json)",
      "Bash(cargo +1.99.1 fmt:*)",
      "Bash(cargo +1.99.1 clippy:*)",
      "Bash(cargo +1.99.1 test:*)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git checkout --:*)",
      "Bash(git clean:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/snapshot-update-guard.sh"
          }
        ]
      }
    ]
  }
}
