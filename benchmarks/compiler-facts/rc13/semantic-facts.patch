+        };
+        let traced = compile(source, &settings).unwrap();
+        let plain = compile(
+            source,
+            &CompileOptions {
+                semantic_trace: false,
+                ..settings
+            },
+        )
+        .unwrap();
+        assert_eq!(traced.code, plain.code);
+        assert_eq!(traced.source_map, plain.source_map);
+        let trace = traced.semantic_trace.unwrap();
+        let site = trace
+            .sites
+            .iter()
+            .find(|site| site.kind == ExecutionSiteKind::Ref)
+            .unwrap();
+        assert_eq!(
+            site.decision,
+            TerminalDecision::Callback(CallbackDecision::Elided)
+        );
+    }
+}
