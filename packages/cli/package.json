{
  "name": "solid-checker",
  "version": "0.1.0",
  "description": "Project-level reactivity checker and language server for Solid",
  "type": "module",
  "exports": {
    ".": {
      "types": "./wasm.d.ts",
      "import": "./wasm.mjs",
      "default": "./wasm.mjs"
    },
    "./eslint": {
      "types": "./eslint.d.ts",
      "default": "./eslint.cjs"
    }
  },
  "bin": {
    "solid-checker": "bin/solid-checker.mjs"
  },
  "files": [
    "bin",
    "eslint.cjs",
    "eslint.d.ts",
    "lib",
    "wasm.d.ts",
    "wasm.mjs",
    "native",
    "native-manifest.json",
    "scripts"
  ],
  "scripts": {
    "prepack": "bun ./scripts/validate-package.mjs",
    "test": "bun ./node_modules/vitest/vitest.mjs run --config vitest.config.mjs test/*.test.mjs && bun ./node_modules/typescript/bin/tsc -p test/types/tsconfig.json",
    "test:types": "bun ./node_modules/typescript/bin/tsc -p test/types/tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint": "10.8.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.4.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yumemi-thomas/solid-checker.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/yumemi-thomas/solid-checker/issues"
  },
  "homepage": "https://github.com/yumemi-thomas/solid-checker#readme",
  "keywords": [
    "solid",
    "solidjs",
    "linter",
    "reactivity",
    "language-server"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
