{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solid-checker.dev/schema/typefacts-v1.schema.json",
  "title": "TypeFactsSchema v1 (latest semantic vocabulary)",
  "description": "Length-prefixed deterministic-CBOR request and response frames exchanged with solid-typefacts. Field names are the CBOR map keys. Optional fields are omitted, never null. Handshake protocol 3 adds the read-only invocations operation for selected-signature, exact binding, callable-path, finite-partition, parameter-use, and control-flow proof transcripts. V1 is the sole active lifecycle schema. The retained table remains Wire schema v17 because invocation transcripts are demand-shaped side answers rather than retained rows. The producer hashes this file and reports the digest in its startup handshake; both executables additionally ship in build-ID lockstep.",
  "oneOf": [
    { "$ref": "#/$defs/lifecycleRequest" },
    { "$ref": "#/$defs/lifecycleResponse" }
  ],
  "$defs": {
    "bytes": {
      "type": "string",
      "description": "CBOR byte string; JSON Schema has no byte-string type."
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "startByte", "endByte"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "startByte": { "type": "integer", "minimum": 0 },
        "endByte": { "type": "integer", "minimum": 0 }
      }
    },
    "fileChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 0 },
        "source": { "$ref": "#/$defs/bytes" },
        "deleted": { "type": "boolean" }
      }
    },
    "entityDemand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location"],
      "properties": {
        "location": { "$ref": "#/$defs/location" },
        "queryLocation": { "$ref": "#/$defs/location" },
        "symbol": { "type": "boolean" },
        "typeDescriptor": { "type": "boolean" },
        "resolvedCall": { "type": "boolean" },
        "callability": { "type": "boolean" },
        "constructability": { "type": "boolean" },
        "runtimeValueDomain": { "type": "boolean" },
        "primitiveValueDomain": { "type": "boolean" },
        "primitiveLiteralCandidates": { "type": "boolean" },
        "parameterObjectShape": { "type": "boolean" },
        "callResultDomain": { "type": "boolean" },
        "constantValue": { "type": "boolean" },
        "arrayShape": { "type": "boolean" },
        "tupleShape": { "type": "boolean" },
        "libraryTypes": { "type": "boolean" },
        "referenceSpace": { "type": "boolean" },
        "runtimeIdentity": { "type": "boolean" },
        "references": { "type": "boolean" },
        "async": { "type": "boolean" },
        "structuralAccessor": { "type": "boolean" }
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "location"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "location": { "$ref": "#/$defs/location" }
      }
    },
    "moduleInventoryDemand": {
      "type": "object",
      "additionalProperties": false,
      "description": "Selects how much of the resolved module graph one modules operation answers. The module inventory itself is unconditional. Imports with no importPaths covers every file the program included.",
      "properties": {
        "imports": { "type": "boolean" },
        "importPaths": { "type": "array", "maxItems": 1000000, "items": { "type": "string", "minLength": 1 } },
        "packages": { "type": "boolean" }
      }
    },
    "projectReferenceMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "outputDts"],
      "description": "The compiler's own pairing of one input file with the declaration file emitted from it. Present only where a configured project reference covers the file, and the only declaration-to-implementation pairing TypeScript maintains. A shipped .d.ts beside a .js never has one.",
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "outputDts": { "type": "string", "minLength": 1 }
      }
    },
    "moduleFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "description": "One file the TypeScript program resolved and included, as the program holds it. For a module reached through a symlink the path is the realpath.",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "declarationFile": { "type": "boolean" },
        "format": { "enum": ["commonjs", "esm", "preserve"] },
        "projectReference": { "$ref": "#/$defs/projectReferenceMapping" },
        "redirectTargets": { "type": "array", "maxItems": 1000000, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "packageIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestPath"],
      "description": "The nearest enclosing package.json found by the compiler's own package-scope lookup, and that manifest's own name and version. An absent name or version is a fact about the manifest, not a lookup failure.",
      "properties": {
        "manifestPath": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "resolverPackageId": {
      "type": "object",
      "additionalProperties": false,
      "description": "The package identity the resolver itself recorded while resolving one specifier. It can name a different package than the nearest enclosing manifest. subpath is the selected file's path within the package, not the exports key that led there.",
      "properties": {
        "name": { "type": "string" },
        "subpath": { "type": "string" },
        "version": { "type": "string" },
        "peerDependencies": { "type": "string" }
      }
    },
    "moduleImportFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specifier", "text", "resolution"],
      "description": "One module specifier occurrence and what the compiler's resolver recorded for it. resolvedPath is empty exactly when resolution is unresolved. symlinkPath is populated only where the resolver's own realpath differed from the path it walked. includedPath is populated only where the program parses a different file than the one resolved, which happens for a configured project reference's declaration output and for nothing else.",
      "properties": {
        "specifier": { "$ref": "#/$defs/location" },
        "text": { "type": "string" },
        "resolution": { "enum": ["unresolved", "relative", "nodeModules", "nonRelative"] },
        "resolvedPath": { "type": "string" },
        "includedPath": { "type": "string" },
        "symlinkPath": { "type": "string" },
        "extension": { "type": "string" },
        "tsExtension": { "type": "boolean" },
        "pathsPattern": { "type": "string" },
        "package": { "$ref": "#/$defs/packageIdentity" },
        "resolverPackage": { "$ref": "#/$defs/resolverPackageId" }
      }
    },
    "symbolQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "references": { "type": "boolean" },
        "referencesOnly": { "type": "boolean" }
      }
    },
    "symbolFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "aliasTarget": { "type": "string" },
        "declarations": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/declaration" } },
        "references": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/location" } }
      }
    },
    "compactDemands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groups", "strings"],
      "description": "Demand snapshot with one string dictionary per frame; index 0 is the empty string. Each group is [pathIndex, packedRows] where packedRows holds unsigned LEB128 (flags << 1 | hasQuery, startDelta, length) triples, each optionally followed by (queryPath, queryStart, queryLength). Bit 9 requests runtimeValueDomain, bit 10 requests callResultDomain, bit 11 requests constantValue, bit 12 requests arrayShape, bit 13 requests tupleShape, bit 14 requests libraryTypes, bit 15 requests primitiveValueDomain, bit 16 requests constructability, bit 17 requests primitiveLiteralCandidates, and bit 18 requests parameterObjectShape.",
      "properties": {
        "groups": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              { "type": "integer", "minimum": 0 },
              { "$ref": "#/$defs/bytes" }
            ]
          }
        },
        "strings": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } }
      }
    },
    "invocationDemand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location"],
      "properties": {
        "location": { "$ref": "#/$defs/location" },
        "callableDepth": { "type": "integer", "minimum": 0, "maximum": 8 },
        "census": { "type": "boolean" }
      }
    },
    "typeDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "text": { "type": "string" },
        "originModule": { "type": "string" },
        "aliasDeclarations": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/declaration" } }
      }
    },
    "declarationOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "location"],
      "properties": {
        "symbol": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "location": { "$ref": "#/$defs/location" }
      }
    },
    "resolvedDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "location"],
      "properties": {
        "symbol": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "location": { "$ref": "#/$defs/location" },
        "owners": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/declarationOwner" } },
        "qualifiedName": { "type": "string" },
        "originModule": { "type": "string" },
        "sourceFile": { "type": "string" },
        "standardLibrary": { "type": "boolean" }
      }
    },
    "callTargetSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exhaustive": { "type": "boolean" },
        "candidates": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/resolvedDeclaration" } }
      }
    },
    "primitiveLiteral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["string", "number", "boolean"] },
        "string": { "type": "string" },
        "number": { "type": "number" },
        "boolean": { "type": "boolean" }
      }
    },
    "discriminant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "value"],
      "properties": {
        "property": { "type": "string" },
        "value": { "$ref": "#/$defs/primitiveLiteral" }
      }
    },
    "pathSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["property", "tuple"] },
        "property": { "type": "string" },
        "index": { "type": "integer", "minimum": 0 }
      }
    },
    "callablePath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alternative", "presence", "callability", "constructability"],
      "properties": {
        "alternative": { "type": "integer", "minimum": 0 },
        "path": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/pathSegment" } },
        "presence": { "enum": ["required", "optional", "absent", "unknown"] },
        "callability": { "enum": ["callable", "untypedCallable", "nonCallable", "mixed", "unknown"] },
        "constructability": { "enum": ["constructable", "nonConstructable", "mixed", "unknown"] },
        "declaration": { "$ref": "#/$defs/declaration" },
        "complete": { "type": "boolean" },
        "openReasons": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } }
      }
    },
    "valueAlternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "discriminants": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/discriminant" } },
        "openReasons": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } }
      }
    },
    "finiteCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string" },
        "literal": { "$ref": "#/$defs/primitiveLiteral" },
        "protocol": { "enum": ["plain", "promise", "asyncIterable"] },
        "tupleLength": { "type": "integer", "minimum": 0 },
        "discriminants": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/discriminant" } }
      }
    },
    "finitePartition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis"],
      "properties": {
        "axis": { "enum": ["literal", "callability", "protocol", "tuple", "discriminant"] },
        "complete": { "type": "boolean" },
        "cases": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/finiteCase" } }
      }
    },
    "valuePrimitiveDomain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mayBeString": { "type": "boolean" },
        "mayBeNumber": { "type": "boolean" },
        "mayBeBoolean": { "type": "boolean" },
        "mayBeBigInt": { "type": "boolean" },
        "mayBeSymbol": { "type": "boolean" },
        "mayBeNull": { "type": "boolean" },
        "mayBeUndefined": { "type": "boolean" },
        "mayBeObject": { "type": "boolean" },
        "numbersFinite": { "type": "boolean" },
        "unknown": { "type": "boolean" }
      }
    },
    "invocationValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callability", "constructability", "primitive"],
      "properties": {
        "type": { "$ref": "#/$defs/typeDescriptor" },
        "callability": { "enum": ["callable", "untypedCallable", "nonCallable", "mixed", "unknown"] },
        "constructability": { "enum": ["constructable", "nonConstructable", "mixed", "unknown"] },
        "primitive": { "$ref": "#/$defs/valuePrimitiveDomain" },
        "alternatives": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/valueAlternative" } },
        "partitions": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/finitePartition" } },
        "openReasons": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } }
      }
    },
    "selectedParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "value"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "symbol": { "type": "string" },
        "declaration": { "$ref": "#/$defs/declaration" },
        "rest": { "type": "boolean" },
        "optional": { "type": "boolean" },
        "defaulted": { "type": "boolean" },
        "value": { "$ref": "#/$defs/invocationValue" },
        "callablePaths": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/callablePath" } }
      }
    },
    "selectedSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "declaration", "overloadOrdinal", "minimumArgumentCount", "result"],
      "properties": {
        "identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "declaration": { "$ref": "#/$defs/resolvedDeclaration" },
        "overloadOrdinal": { "type": "integer", "minimum": 0 },
        "minimumArgumentCount": { "type": "integer", "minimum": 0 },
        "hasRest": { "type": "boolean" },
        "parameters": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/selectedParameter" } },
        "result": { "$ref": "#/$defs/invocationValue" },
        "resultCallablePaths": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/callablePath" } }
      }
    },
    "expandedArgumentSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expandedIndex", "parameterIndex"],
      "properties": {
        "expandedIndex": { "type": "integer", "minimum": 0 },
        "tupleIndex": { "type": "integer", "minimum": 0 },
        "parameterIndex": { "type": "integer", "minimum": 0 },
        "rest": { "type": "boolean" }
      }
    },
    "formalRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "endExclusive": { "type": "integer", "minimum": 0 },
        "unbounded": { "type": "boolean" }
      }
    },
    "argumentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argumentIndex", "location", "disposition"],
      "properties": {
        "argumentIndex": { "type": "integer", "minimum": 0 },
        "location": { "$ref": "#/$defs/location" },
        "disposition": { "enum": ["direct", "exactTupleSpread", "unknownLengthSpread", "unmapped"] },
        "slots": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/expandedArgumentSlot" } },
        "possible": { "$ref": "#/$defs/formalRange" },
        "reason": { "type": "string" }
      }
    },
    "parameterUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameterIndex", "location", "kind"],
      "properties": {
        "parameterIndex": { "type": "integer", "minimum": 0 },
        "bindingPath": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/pathSegment" } },
        "location": { "$ref": "#/$defs/location" },
        "kind": { "enum": ["directCall", "aliasCall", "argumentKnown", "argumentUnknown", "propertyAccess", "return", "storage", "capture", "unknownEscape"] },
        "alias": { "type": "boolean" },
        "captured": { "type": "boolean" }
      }
    },
    "returnSite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "reach"],
      "properties": {
        "location": { "$ref": "#/$defs/location" },
        "reach": { "enum": ["reachable", "unreachable", "unknown"] },
        "value": { "$ref": "#/$defs/invocationValue" },
        "captures": { "type": "array", "maxItems": 1000000, "items": { "type": "integer", "minimum": 0 } }
      }
    },
    "throwSite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "reach"],
      "properties": {
        "location": { "$ref": "#/$defs/location" },
        "reach": { "enum": ["reachable", "unreachable", "unknown"] }
      }
    },
    "branchSite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "reach"],
      "properties": {
        "location": { "$ref": "#/$defs/location" },
        "reach": { "enum": ["reachable", "unreachable", "unknown"] },
        "partitions": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/finitePartition" } }
      }
    },
    "controlFlowCensus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "returns": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/returnSite" } },
        "throws": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/throwSite" } },
        "branches": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/branchSite" } },
        "unsupported": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } }
      }
    },
    "invocationTranscript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "validity", "kind"],
      "properties": {
        "location": { "$ref": "#/$defs/location" },
        "validity": { "enum": ["valid", "recovery", "unresolved"] },
        "kind": { "enum": ["unknown", "call", "construct"] },
        "target": { "type": "string" },
        "targets": { "$ref": "#/$defs/callTargetSet" },
        "selectedSignature": { "$ref": "#/$defs/selectedSignature" },
        "bindings": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/argumentBinding" } },
        "omittedParameters": { "type": "array", "maxItems": 1000000, "items": { "type": "integer", "minimum": 0 } },
        "parameterUses": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/parameterUse" } },
        "controlFlow": { "$ref": "#/$defs/controlFlowCensus" },
        "complete": { "type": "array", "uniqueItems": true, "items": { "enum": ["signature", "bindings", "omissions", "parameters", "result", "uses", "controlFlow"] } },
        "openReasons": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } }
      }
    },
    "transcriptSourceDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "invocationEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "demandSha256", "moduleGraphSha256"],
      "properties": {
        "projectId": { "type": "string" },
        "generation": { "type": "integer", "minimum": 1 },
        "demandSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "moduleGraphSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "schemaSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "producerBuild": { "type": "string" },
        "sources": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/transcriptSourceDigest" } },
        "openReasons": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } }
      }
    },
    "lifecycleRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "requestId", "operation", "projectId", "generation"],
      "properties": {
        "schema": { "const": 1 },
        "requestId": { "type": "integer", "minimum": 1 },
        "operation": {
          "enum": ["open", "update", "analyze", "symbols", "sources", "modules", "invocations", "cancel", "close"]
        },
        "projectId": { "type": "string", "minLength": 1 },
        "generation": { "type": "integer", "minimum": 1 },
        "changes": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/fileChange" } },
        "demands": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/entityDemand" } },
        "compactDemands": { "$ref": "#/$defs/compactDemands" },
        "stateToken": { "type": "string" },
        "resetState": { "type": "boolean" },
        "removedDemandPaths": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } },
        "symbolQueries": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/symbolQuery" } },
        "releaseAnalysis": { "type": "boolean" },
        "referenceChanges": { "type": "boolean" },
        "referencePaths": { "type": "array", "maxItems": 1000000, "items": { "type": "string", "minLength": 1 } },
        "cancelRequestId": { "type": "integer", "minimum": 0 },
        "moduleGraph": { "$ref": "#/$defs/moduleInventoryDemand" },
        "invocationDemands": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/invocationDemand" } }
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyzeNs"],
      "properties": {
        "requestDecodeNs": { "type": "integer", "minimum": 0 },
        "analyzeNs": { "type": "integer", "minimum": 0 },
        "asyncNs": { "type": "integer", "minimum": 0 },
        "demandNs": { "type": "integer", "minimum": 0 },
        "assemblyNs": { "type": "integer", "minimum": 0 },
        "sortNs": { "type": "integer", "minimum": 0 },
        "closeSymbolsNs": { "type": "integer", "minimum": 0 },
        "materialized": { "type": "boolean" },
        "retainedFiles": { "type": "integer", "minimum": 0 },
        "recomputedFiles": { "type": "integer", "minimum": 0 },
        "nonDurableFiles": { "type": "integer", "minimum": 0 }
      }
    },
    "lifecycleResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "requestId", "projectId", "generation", "ok"],
      "description": "Analyze carries at most one opaque tableTransition. The transition proves its base project, generation, and state token and selects full or delta mode internally. An absent transition reuses the retained table. The modules operation instead carries modules, moduleImports, and unknownImportPaths as plain rows: the resolved module graph is a property of the accepted program rather than of a demand set, so it takes no part in retained table identity.",
      "properties": {
        "schema": { "const": 1 },
        "requestId": { "type": "integer", "minimum": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "generation": { "type": "integer", "minimum": 1 },
        "ok": { "type": "boolean" },
        "tableTransition": {
          "$ref": "#/$defs/bytes",
          "description": "Opaque full-or-delta Wire table transition. The active lifecycle schema emits Wire table schema v17. V15 introduced untypedCallable (tag 4), v16 added primitive literal candidates, and v17 added parameter object-construction shapes; older table schemas remain frozen and reject facts they cannot represent."
        },
        "symbolEvidence": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/symbolFact" } },
        "referenceEvidence": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/symbolFact" } },
        "changedReferenceSymbols": { "type": "array", "maxItems": 1000000, "items": { "type": "string", "minLength": 1 } },
        "referenceChangesExact": { "type": "boolean" },
        "stateToken": { "type": "string" },
        "affected": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } },
        "sources": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "source": { "$ref": "#/$defs/bytes" },
              "local": { "type": "boolean" }
            }
          }
        },
        "sourceArena": {
          "type": "string",
          "description": "Filesystem path to a temporary file holding every source body back to back, sliced by sourceLengths. Implies a producer and client that share a filesystem."
        },
        "sourceLengths": { "type": "array", "maxItems": 1000000, "items": { "type": "integer", "minimum": 0 } },
        "modules": {
          "type": "array",
          "maxItems": 1000000,
          "description": "Every file the program included, ordered by path. A modules operation always answers it.",
          "items": { "$ref": "#/$defs/moduleFact" }
        },
        "moduleImports": {
          "type": "array",
          "maxItems": 1000000,
          "description": "Resolved provenance for the requested files' module specifiers, ordered by importing path then by specifier start byte.",
          "items": { "$ref": "#/$defs/moduleImportFact" }
        },
        "unknownImportPaths": {
          "type": "array",
          "maxItems": 1000000,
          "description": "Requested import paths the program does not hold, ordered by path. Reported rather than dropped so a caller can tell a file with no imports from a file that was never analyzed.",
          "items": { "type": "string", "minLength": 1 }
        },
        "invocationTranscripts": {
          "type": "array",
          "maxItems": 1000000,
          "items": { "$ref": "#/$defs/invocationTranscript" }
        },
        "invocationEnvelope": { "$ref": "#/$defs/invocationEnvelope" },
        "timings": { "$ref": "#/$defs/timings" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string" }
          }
        }
      }
    }
  }
}
