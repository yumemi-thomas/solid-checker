{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solid-checker.dev/schema/solid-reactivity.schema.json",
  "title": "Solid Reactivity Package Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "package",
    "compilerFactsProtocol",
    "summaries",
    "entrypoints",
    "evidence"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "integrity": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]{86}==$" }
      }
    },
    "compilerFactsProtocol": { "const": 1 },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "declaration": { "$ref": "#/$defs/artifact" },
        "implementation": { "$ref": "#/$defs/artifact" }
      }
    },
    "summaries": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/export" }
    },
    "entrypoints": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^(\\.|\\./.+)$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "oneOf": [
          {
            "required": ["exports"],
            "not": { "required": ["sameAs"] }
          },
          {
            "required": ["sameAs"],
            "not": { "required": ["exports"] }
          }
        ],
        "properties": {
          "exports": { "$ref": "#/$defs/exportGroups" },
          "sameAs": {
            "type": "string",
            "pattern": "^(\\.|\\./.+)$"
          },
          "conditions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["generated", "inferred", "verified", "reviewed", "trusted", "attested"]
        },
        "generator": { "type": "string" }
      }
    }
  },
  "$defs": {
    "exportGroups": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "minLength": 1 },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["function", "value"] },
        "returns": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "label"],
          "properties": {
            "kind": { "enum": ["accessor", "store-path"] },
            "label": { "type": "string", "minLength": 1 }
          }
        },
        "callbacks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["parameter", "execution"],
            "properties": {
              "parameter": { "type": "integer", "minimum": 0 },
              "execution": { "enum": ["inline", "tracked", "deferred"] }
            }
          }
        },
        "asyncBehavior": { "enum": ["promise", "async-iterable"] },
        "reactiveReads": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "label"],
            "properties": {
              "kind": { "enum": ["accessor", "store-path"] },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}
