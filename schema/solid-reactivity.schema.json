{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yumemi-thomas/solid-checker/schema/solid-reactivity.schema.json",
  "title": "Solid Reactivity Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "semanticModelVersion",
    "package",
    "summaries",
    "entrypoints",
    "sidecars"
  ],
  "properties": {
    "format": { "const": "solid-reactivity-contract" },
    "schemaVersion": { "const": 1 },
    "semanticModelVersion": { "const": 1 },
    "package": { "$ref": "#/$defs/package" },
    "summaries": {
      "type": "object",
      "maxProperties": 16384,
      "propertyNames": { "$ref": "#/$defs/nonemptyString" },
      "additionalProperties": { "$ref": "#/$defs/summary" }
    },
    "entrypoints": {
      "type": "object",
      "maxProperties": 1024,
      "propertyNames": { "$ref": "#/$defs/nonemptyString" },
      "additionalProperties": { "$ref": "#/$defs/entrypoint" }
    },
    "sidecars": { "$ref": "#/$defs/sidecars" }
  },
  "$defs": {
    "string": { "type": "string", "maxLength": 16384 },
    "nonemptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "integrity", "manifest"],
      "properties": {
        "name": { "$ref": "#/$defs/nonemptyString" },
        "version": { "$ref": "#/$defs/nonemptyString" },
        "integrity": { "$ref": "#/$defs/nonemptyString" },
        "manifest": { "$ref": "#/$defs/file" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtimeArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "closureSha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "closureSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sidecars": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proof": { "$ref": "#/$defs/hashReference" },
        "probes": { "$ref": "#/$defs/hashReference" }
      }
    },
    "hashReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": { "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "entrypoint": {
      "oneOf": [
        { "$ref": "#/$defs/unconditionalEntrypoint" },
        { "$ref": "#/$defs/conditionalEntrypoint" }
      ]
    },
    "unconditionalEntrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "declarations", "exports"],
      "properties": {
        "initialization": { "enum": ["inert"] },
        "artifact": { "$ref": "#/$defs/runtimeArtifact" },
        "declarations": { "$ref": "#/$defs/file" },
        "transform": { "$ref": "#/$defs/file" },
        "stability": { "$ref": "#/$defs/stability" },
        "exports": { "$ref": "#/$defs/exportMap" }
      }
    },
    "conditionalEntrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases"],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/artifactCase" }
        }
      }
    },
    "artifactCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution", "artifact", "declarations", "exports"],
      "properties": {
        "initialization": { "enum": ["inert"] },
        "resolution": { "$ref": "#/$defs/resolution" },
        "artifact": { "$ref": "#/$defs/runtimeArtifact" },
        "declarations": { "$ref": "#/$defs/file" },
        "transform": { "$ref": "#/$defs/file" },
        "stability": { "$ref": "#/$defs/stability" },
        "exports": { "$ref": "#/$defs/exportMap" }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeBranch", "typesBranch"],
      "properties": {
        "runtimeBranch": { "$ref": "#/$defs/nonemptyString" },
        "typesBranch": { "$ref": "#/$defs/nonemptyString" }
      }
    },
    "stability": { "const": "experimental" },
    "exportMap": {
      "type": "object",
      "maxProperties": 65536,
      "propertyNames": { "$ref": "#/$defs/nonemptyString" },
      "additionalProperties": { "$ref": "#/$defs/exportReference" }
    },
    "exportReference": {
      "oneOf": [
        { "$ref": "#/$defs/nonemptyString" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary"],
          "properties": {
            "summary": { "$ref": "#/$defs/nonemptyString" },
            "stability": { "$ref": "#/$defs/stability" }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape"],
      "properties": {
        "shape": { "$ref": "#/$defs/value" },
        "call": { "$ref": "#/$defs/call" }
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "closed": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/callDomain" }
        },
        "proposedClosures": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/callDomain" }
        },
        "contextPremises": {
          "description": "ADR 0153 part 3: every claim of this export holds only in a program where the context this package exports under each named export receives no value from outside the package. A consumer that cannot show that reads every domain of the export as open.",
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonemptyString" }
        },
        "accessorBounds": {
          "description": "ADR 0153 item C: the closure's runtime-accessor-installation hazard sources, as the closure manifest names them, that this export's closed reads holds against: each installs on a target its installing function allocates fresh and on which this export executes no operation. A consumer opens reads for every accessor hazard of the closure this list does not name. Stated only beside a closed reads.",
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonemptyString" }
        },
        "callbacks": {
          "type": "array",
          "items": { "$ref": "#/$defs/callback" }
        },
        "reads": { "$ref": "#/$defs/operationIds" },
        "writes": { "$ref": "#/$defs/operationIds" },
        "creates": { "$ref": "#/$defs/operationIds" },
        "invalidates": { "$ref": "#/$defs/operationIds" },
        "throws": { "$ref": "#/$defs/operationIds" },
        "returns": { "$ref": "#/$defs/operationIds" },
        "cleanups": { "$ref": "#/$defs/operationIds" },
        "disposals": { "$ref": "#/$defs/operationIds" },
        "computations": {
          "$comment": "ADR 0114: stated by item only in schema version 1, so it is not a callDomain and neither closed nor proposedClosures may name it.",
          "$ref": "#/$defs/operationIds"
        },
        "operations": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/operation" }
        },
        "edges": {
          "type": "array",
          "maxItems": 8192,
          "items": { "$ref": "#/$defs/edge" }
        },
        "resources": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/resource" }
        },
        "cases": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/guardedCase" }
        }
      }
    },
    "callDomain": {
      "enum": [
        "callbacks",
        "reads",
        "writes",
        "creates",
        "invalidates",
        "throws",
        "returns",
        "cleanups",
        "disposals"
      ]
    },
    "operationIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonemptyString" }
    },
    "callback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "operation"],
      "properties": {
        "from": { "$ref": "#/$defs/valueSource" },
        "operation": { "$ref": "#/$defs/nonemptyString" }
      }
    },
    "valueSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "arg": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "operation": { "$ref": "#/$defs/nonemptyString" },
        "resource": { "$ref": "#/$defs/nonemptyString" },
        "path": { "$ref": "#/$defs/stringPath" },
        "members": {
          "$comment": "ADR 0207: a class of the value's own members the item names. `event-handler-props` is every key that starts with `on` and contains no `:`, the properties the Solid runtime's spread attaches as event listeners. The item is exhaustive for its class whatever the domain's closure; its operation is an `invoke` of the call protocol, and only `arg` may name the value. A decoder that predates the field refuses the document, which is intended.",
          "enum": ["event-handler-props"]
        }
      },
      "oneOf": [
        { "required": ["arg"], "not": { "anyOf": [{ "required": ["operation"] }, { "required": ["resource"] }] } },
        { "required": ["operation"], "not": { "anyOf": [{ "required": ["arg"] }, { "required": ["resource"] }, { "required": ["members"] }] } },
        { "required": ["resource"], "not": { "anyOf": [{ "required": ["arg"] }, { "required": ["operation"] }, { "required": ["members"] }] } }
      ]
    },
    "stringPath": {
      "type": "array",
      "items": { "$ref": "#/$defs/string" }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/nonemptyString" },
        "kind": { "enum": ["invoke", "return", "read", "write", "invalidate", "create", "cleanup", "dispose", "compute"] },
        "guard": { "$ref": "#/$defs/guard" },
        "trigger": { "$ref": "#/$defs/trigger" },
        "at": { "$ref": "#/$defs/executionPoint" },
        "tracking": { "enum": ["tracked", "untracked", "ambient-at-execution"] },
        "owner": { "$ref": "#/$defs/owner" },
        "count": { "$ref": "#/$defs/cardinality" },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/value" }
        },
        "output": { "$ref": "#/$defs/value" },
        "resources": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonemptyString" }
        },
        "composedFrom": { "$ref": "#/$defs/composedFrom" },
        "protocol": {
          "$comment": "Which protocol of the caller's value an invoke runs. Absence means call. Legacy non-call forms retain their call 0..many shape; the two value enumerations have the narrower counts described below. Every non-call form is same-stack, ambient-at-execution, unguarded and named by one callbacks item from a bare parameter. Unknown protocol spellings are refused.",
          "enum": ["call", "get", "iterate", "coerce", "has-instance", "get-enumerable-string-values", "get-own-enumerable-values"],
          "description": "Value enumerations are distinct from broad get. get-enumerable-string-values enters one for-in value-copy enumeration per call (count call 1..1); get-own-enumerable-values may enter one own enumerable string+symbol value-copy enumeration after an unproved prefix (count call 0..1). Both use a bare parameter, call trigger/event, same-stack, ambient tracking and owner, no guard, inputs, output, resources or provenance. A count is about entering the enumeration; each getter requires a separate receiver, descriptor and prefix proof. Old documents retain their meaning."
        }
      },
      "allOf": [
        {
          "if": { "required": ["protocol"], "properties": { "protocol": { "enum": ["get-enumerable-string-values", "get-own-enumerable-values"] } } },
          "then": {
            "required": ["trigger", "at", "tracking", "owner", "count"],
            "properties": {
              "kind": { "const": "invoke" },
              "trigger": { "const": { "event": "call" } },
              "at": { "const": { "event": "call", "schedule": "same-stack" } },
              "tracking": { "const": "ambient-at-execution" },
              "owner": { "const": { "source": "ambient-at-execution" } },
              "inputs": { "maxItems": 0 },
              "resources": { "maxItems": 0 },
              "count": { "required": ["scope", "min", "max"], "properties": { "scope": { "const": "call" }, "max": { "const": 1 } } }
            },
            "not": { "anyOf": [{ "required": ["guard"] }, { "required": ["output"] }, { "required": ["composedFrom"] }] }
          }
        },
        {
          "if": { "required": ["protocol"], "properties": { "protocol": { "const": "get-enumerable-string-values" } } },
          "then": { "properties": { "count": { "properties": { "min": { "const": 1 } } } } }
        },
        {
          "if": { "required": ["protocol"], "properties": { "protocol": { "const": "get-own-enumerable-values" } } },
          "then": { "properties": { "count": { "properties": { "min": { "const": 0 } } } } }
        }
      ]
    },
    "composedFrom": {
      "description": "The export and operation of the SAME artifact case this operation was composed from: the behaviour this operation describes is that export's own operation, performed through this export's call to it. `operation` is the target's own local operation id (`read-0`), never a qualified one -- a document cannot name an operation outside the artifact case that carries it. Optional and additive: an operation that omits it makes no provenance claim, and a consumer then requires this export's own evidence for the row. Only a `read` operation may carry it. A consumer must not read it as authority: it names a target to prove against, and discharging it requires proving both that this export really calls that export (by resolved declaration, never by name) and that the target's own claim for the named operation holds.",
      "type": "object",
      "additionalProperties": false,
      "required": ["export", "operation"],
      "properties": {
        "export": { "$ref": "#/$defs/nonemptyString" },
        "operation": { "$ref": "#/$defs/nonemptyString" }
      }
    },
    "event": {
      "$comment": "`result-access` (ADR 0139) is valid only as both the trigger and the execution point of an `invoke` that exactly one `callbacks` item names from a bare parameter, scheduled `external`, `ambient-at-execution` for tracking and owner with unconstrained requirements, count trigger 0..many, unguarded, with no protocol, inputs, output or resources. It says the export stores the caller's callable only in the value it returns (for a construction, the instance), and the callable runs later, on the stack of code that invokes it through that value. A document stating it hashes in a digest family of its own (`solid-checker:semantic-result-access:v1`); a decoder that predates the event refuses the document, which is intended.",
      "enum": ["call", "render", "flush", "settle", "transition", "async-emission", "cleanup", "external-event", "request", "response-commitment", "result-access"]
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event": { "$ref": "#/$defs/event" },
        "operation": { "$ref": "#/$defs/nonemptyString" },
        "resource": { "$ref": "#/$defs/nonemptyString" }
      },
      "oneOf": [
        { "required": ["event"], "not": { "anyOf": [{ "required": ["operation"] }, { "required": ["resource"] }] } },
        { "required": ["operation"], "not": { "anyOf": [{ "required": ["event"] }, { "required": ["resource"] }] } },
        { "required": ["event", "resource"], "not": { "required": ["operation"] } }
      ]
    },
    "executionPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "schedule"],
      "properties": {
        "event": { "$ref": "#/$defs/event" },
        "schedule": { "enum": ["same-stack", "queued", "external"] }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "enum": ["none", "ambient-at-call", "ambient-at-execution", "captured", "created"] },
        "resource": { "$ref": "#/$defs/nonemptyString" },
        "requires": { "$ref": "#/$defs/requirement" },
        "requiresChildren": { "$ref": "#/$defs/requirement" },
        "requiresCleanup": { "$ref": "#/$defs/requirement" },
        "children": { "enum": ["allowed", "forbidden"] },
        "cleanup": { "enum": ["supported", "forbidden"] },
        "lifetime": { "$ref": "#/$defs/lifetime" },
        "closed": {
          "type": "array",
          "uniqueItems": true,
          "items": { "const": "productions" }
        },
        "productions": {
          "type": "array",
          "items": { "$ref": "#/$defs/ownerProduction" }
        }
      }
    },
    "requirement": { "enum": ["required", "forbidden", "unconstrained"] },
    "ownerProduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource"],
      "properties": {
        "resource": { "$ref": "#/$defs/nonemptyString" },
        "children": { "enum": ["allowed", "forbidden"] },
        "cleanup": { "enum": ["supported", "forbidden"] },
        "lifetime": { "$ref": "#/$defs/lifetime" }
      }
    },
    "lifetime": {
      "oneOf": [
        { "enum": ["call", "resource", "owner", "request", "transition", "async-source"] },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "resource"],
          "properties": {
            "kind": { "enum": ["resource", "owner", "request", "transition", "async-source"] },
            "resource": { "$ref": "#/$defs/nonemptyString" }
          }
        }
      ]
    },
    "cardinality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": { "enum": ["trigger", "call", "resource"] },
        "resource": { "$ref": "#/$defs/nonemptyString" },
        "min": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "max": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            { "const": "many" }
          ]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "from", "to"],
      "properties": {
        "kind": { "enum": ["orders", "data", "invalidates", "error", "cleanup", "lifetime"] },
        "from": { "$ref": "#/$defs/nonemptyString" },
        "to": { "$ref": "#/$defs/nonemptyString" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/nonemptyString" },
        "kind": { "enum": ["owner", "reactive-source", "async-computation", "transition", "cleanup", "request", "response", "stream", "server-function-reference"] },
        "closed": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["states", "capabilities"] }
        },
        "states": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["active", "disposed", "installed", "pending", "settled", "errored", "cancelled", "reverted", "uncommitted", "committed", "unclaimed", "claimed"] }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["refreshable", "writable"] }
        },
        "lifetime": { "$ref": "#/$defs/lifetime" }
      }
    },
    "guardedCase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "when": { "$ref": "#/$defs/guard" },
        "otherwise": { "const": true },
        "operations": { "$ref": "#/$defs/operationIds" },
        "operationsOpen": { "const": true }
      },
      "dependentRequired": { "operationsOpen": ["operations"] },
      "oneOf": [
        { "required": ["when"], "not": { "required": ["otherwise"] } },
        { "required": ["otherwise"], "not": { "required": ["when"] } }
      ]
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all"],
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/guardAtom" }
        }
      }
    },
    "guardValueKind": { "enum": ["plain", "callable", "promise", "async-iterable"] },
    "guardAtom": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["signature"],
          "properties": { "signature": { "$ref": "#/$defs/nonemptyString" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["argumentCount"],
          "properties": {
            "argumentCount": {
              "type": "object",
              "additionalProperties": false,
              "required": ["min"],
              "properties": {
                "min": { "type": "integer", "minimum": 0, "maximum": 65535 },
                "max": { "type": "integer", "minimum": 0, "maximum": 65535 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["arg", "literal"],
          "properties": {
            "arg": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "path": { "$ref": "#/$defs/stringPath" },
            "literal": { "type": ["null", "boolean", "number", "string"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["arg", "kind"],
          "properties": {
            "arg": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "path": { "$ref": "#/$defs/stringPath" },
            "kind": { "$ref": "#/$defs/guardValueKind" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["arg", "property"],
          "properties": {
            "arg": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "path": { "$ref": "#/$defs/stringPath" },
            "property": { "$ref": "#/$defs/nonemptyString" },
            "callable": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["arg", "tupleAlternative"],
          "properties": {
            "arg": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "tupleAlternative": { "type": "integer", "minimum": 0, "maximum": 65535 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["resultProtocol"],
          "properties": { "resultProtocol": { "$ref": "#/$defs/guardValueKind" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifactCase"],
          "properties": { "artifactCase": { "$ref": "#/$defs/nonemptyString" } }
        }
      ]
    },
    "value": {
      "oneOf": [
        { "enum": ["unknown", "plain", "undefined", "callable", "component", "ref-application"] },
        { "$ref": "#/$defs/unknownValue" },
        { "$ref": "#/$defs/plainValue" },
        { "$ref": "#/$defs/parameterValue" },
        { "$ref": "#/$defs/tupleValue" },
        { "$ref": "#/$defs/arrayValue" },
        { "$ref": "#/$defs/objectValue" },
        { "$ref": "#/$defs/choiceValue" },
        { "$ref": "#/$defs/callableValue" },
        { "$ref": "#/$defs/promiseValue" },
        { "$ref": "#/$defs/asyncIterableValue" },
        { "$ref": "#/$defs/reactiveValue" },
        { "$ref": "#/$defs/storeValue" },
        { "$ref": "#/$defs/mergedPropsValue" },
        { "$ref": "#/$defs/argumentArrayValue" },
        { "$ref": "#/$defs/invocationResultValue" },
        { "$ref": "#/$defs/undefinedValue" },
        { "$ref": "#/$defs/describedCallableValue" },
        { "$ref": "#/$defs/effectfulCallableValue" },
        { "$ref": "#/$defs/actionValue" },
        { "$ref": "#/$defs/componentValue" },
        { "$ref": "#/$defs/cleanupValue" },
        { "$ref": "#/$defs/refApplicationValue" },
        { "$ref": "#/$defs/serverFunctionReferenceValue" }
      ]
    },
    "unknownValue": { "$ref": "#/$defs/kindOnlyUnknown" },
    "plainValue": { "$ref": "#/$defs/kindOnlyPlain" },
    "undefinedValue": {
      "description": "Item B round 2 of ways-to-improve § 3.3. Exactly `undefined`: what an optional chain hands back when its receiver is nullish -- the other value of `event?.defaultPrevented`. Narrower than `plain`, and carries no closure of its own.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "undefined" } }
    },
    "callableValue": { "$ref": "#/$defs/kindOnlyCallable" },
    "componentValue": { "$ref": "#/$defs/kindOnlyComponent" },
    "refApplicationValue": { "$ref": "#/$defs/kindOnlyRefApplication" },
    "kindOnlyUnknown": { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "unknown" } } },
    "kindOnlyPlain": { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "plain" } } },
    "kindOnlyCallable": { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "callable" } } },
    "kindOnlyComponent": { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "component" } } },
    "kindOnlyRefApplication": { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "ref-application" } } },
    "parameterValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "index"],
      "properties": {
        "kind": { "const": "parameter" },
        "index": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "path": { "$ref": "#/$defs/stringPath" }
      }
    },
    "tupleValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "tuple" },
        "closed": { "type": "array", "uniqueItems": true, "items": { "const": "items" } },
        "items": { "type": "array", "items": { "$ref": "#/$defs/value" } }
      }
    },
    "arrayValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "array" },
        "element": { "$ref": "#/$defs/value" },
        "length": { "$ref": "#/$defs/arrayLength" }
      }
    },
    "arrayLength": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "max": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            { "const": "many" }
          ]
        }
      }
    },
    "objectValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "object" },
        "closed": { "type": "array", "uniqueItems": true, "items": { "const": "properties" } },
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": { "$ref": "#/$defs/nonemptyString" },
              "value": { "$ref": "#/$defs/value" }
            }
          }
        }
      }
    },
    "choiceValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "choice" },
        "closed": { "type": "array", "uniqueItems": true, "items": { "const": "alternatives" } },
        "alternatives": { "type": "array", "items": { "$ref": "#/$defs/value" } }
      }
    },
    "promiseValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "promise" },
        "value": { "$ref": "#/$defs/value" }
      }
    },
    "asyncIterableValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "async-iterable" },
        "element": { "$ref": "#/$defs/value" }
      }
    },
    "reactiveValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "role"],
      "properties": {
        "kind": { "const": "reactive" },
        "role": { "enum": ["accessor", "setter"] },
        "resource": { "$ref": "#/$defs/nonemptyString" },
        "closed": { "type": "array", "uniqueItems": true, "items": { "const": "capabilities" } },
        "capabilities": { "$ref": "#/$defs/capabilityClaims" }
      }
    },
    "storeValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "store" },
        "resource": { "$ref": "#/$defs/nonemptyString" },
        "closed": { "type": "array", "uniqueItems": true, "items": { "const": "capabilities" } },
        "capabilities": { "$ref": "#/$defs/capabilityClaims" }
      }
    },
    "mergedPropsValue": {
      "description": "ADR 0109. An object whose property reads reach through to the caller's argument at `from`: what a props merge yields. Conditional on purpose \u2014 a merge creates no reactive source, it carries its arguments'. A consumer asserts reactivity of this value exactly when the argument it passed at `from` is itself reactive, and asserts nothing otherwise; reading it as a store would claim reactivity of a merge of plain objects.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "from"],
      "properties": {
        "kind": { "const": "merged-props" },
        "from": { "type": "integer", "minimum": 0 }
      }
    },
    "argumentArrayValue": {
      "description": "ADR 0115. A fresh array whose elements, in order, are exactly the caller's own arguments at `items`: `[value]` is `[0]` and `[]` is empty. Exact by construction, so it carries no closure of its own.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "items"],
      "properties": {
        "kind": { "const": "argument-array" },
        "items": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
      }
    },
    "invocationResultValue": {
      "description": "ADR 0116. The value an invocation of the caller's own argument at `parameter` returned, handed back unchanged: `valueOrFn(...args)` is `0`. Names no argument of the invocation and carries no closure of its own.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "parameter"],
      "properties": {
        "kind": { "const": "invocation-result" },
        "parameter": { "type": "integer", "minimum": 0 }
      }
    },
    "effectfulCallableValue": {
      "description": "ADR 0235. A callable the export hands back as a member of a returned tuple or object, with what one call of it does: its own call graph, whose operations share the export's id namespace and may name the export's resources. Valid only as a direct member of a `return` operation's tuple or object output; never nested; refused by certification.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "call"],
      "properties": {
        "kind": { "const": "effectful-callable" },
        "call": { "$ref": "#/$defs/call" }
      }
    },
    "describedCallableValue": {
      "description": "ADR 0145. A callable the export hands back together with what one invocation of it does, stated exactly: it invokes no callable it did not define, creates nothing, registers nothing on an owner, performs exactly `reads` (on the invoking caller's stack, in that caller's tracking context) and hands back exactly one of `returns` (none: it completes without a value). ADR 0146: `owned-signal` is a read of a signal the export created with the dialect's `createSignal` over primitive arguments, and `read-value` is exactly the value such a read observed. ADR 0162: `owned-memo` is a read of a memo the export created with the dialect's `createMemo` and returned unaltered; it is not inert -- a stale read re-runs the registered computation, which the export's own `creates` and `callbacks` claims account for -- and it invokes no other callable. ADR 0152: `callbacks` names the export arguments one invocation runs, and `invocation-result` in `returns` is exactly what one of them returned. Valid only as the whole output of a `return` operation; carries no closure of its own.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reads", "returns"],
      "properties": {
        "kind": { "const": "described-callable" },
        "reads": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["owned-signal", "owned-memo"] }
        },
        "returns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "oneOf": [
              { "enum": ["plain", "read-value"] },
              { "$ref": "#/$defs/invocationResultValue" }
            ]
          }
        },
        "callbacks": {
          "description": "ADR 0152. The callables one invocation runs that it did not define, each an argument the export was handed and the returned callable captured, in the top-level item's shape with its operation inline. Absent is `[]`, which is how every document before ADR 0152 reads. Validation admits exactly one invocation: triggered by and at the described call, on the same stack, in the invoking caller's tracking context and under its owner, exactly once per call, unguarded. An `invocation-result` in `returns` names an argument one of these items invokes.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/describedCallback" }
        }
      }
    },
    "describedCallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "operation"],
      "properties": {
        "from": { "$ref": "#/$defs/valueSource" },
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "invoke" },
            "trigger": { "$ref": "#/$defs/trigger" },
            "at": { "$ref": "#/$defs/executionPoint" },
            "tracking": { "enum": ["tracked", "untracked", "ambient-at-execution"] },
            "owner": { "$ref": "#/$defs/owner" },
            "count": { "$ref": "#/$defs/cardinality" }
          }
        }
      }
    },
    "capabilityClaims": {
      "type": "array",
      "items": {
        "oneOf": [
          { "enum": ["readable", "writable", "refreshable", "pending-aware", "optimistic"] },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "resource"],
            "properties": {
              "capability": { "enum": ["refreshable", "pending-aware", "optimistic"] },
              "resource": { "$ref": "#/$defs/nonemptyString" }
            }
          }
        ]
      }
    },
    "actionValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "action" },
        "transition": { "$ref": "#/$defs/nonemptyString" }
      }
    },
    "cleanupValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "cleanup" },
        "resource": { "$ref": "#/$defs/nonemptyString" },
        "lifetime": { "$ref": "#/$defs/lifetime" }
      }
    },
    "serverFunctionReferenceValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "server-function-reference" },
        "resource": { "$ref": "#/$defs/nonemptyString" }
      }
    }
  }
}
