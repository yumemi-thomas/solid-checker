{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solid-checker.dev/schema/solid-reactivity.schema.json",
  "title": "Solid Reactivity Package Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "package",
    "compilerFactsProtocol",
    "summaries",
    "entrypoints",
    "evidence"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "integrity": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]{86}==$" }
      }
    },
    "compilerFactsProtocol": { "const": 1 },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "declaration": { "$ref": "#/$defs/artifact" },
        "implementation": { "$ref": "#/$defs/artifact" }
      }
    },
    "summaries": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/export" }
    },
    "entrypoints": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^(\\.|\\./.+)$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "oneOf": [
          {
            "required": ["exports"],
            "not": { "required": ["sameAs"] }
          },
          {
            "required": ["sameAs"],
            "not": { "required": ["exports"] }
          }
        ],
        "properties": {
          "exports": { "$ref": "#/$defs/exportGroups" },
          "sameAs": {
            "type": "string",
            "pattern": "^(\\.|\\./.+)$"
          },
          "conditions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["generated", "inferred", "verified", "reviewed", "trusted", "attested"]
        },
        "generator": { "type": "string" }
      }
    }
  },
  "$defs": {
    "exportGroups": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "minLength": 1 },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["function", "value"] },
        "evidence": { "$ref": "#/$defs/claimEvidence" },
        "returns": {
          "oneOf": [
            { "$ref": "#/$defs/return" },
            { "$ref": "#/$defs/unknownClaim" }
          ]
        },
        "callbacks": {
          "oneOf": [
            {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["parameter", "execution"],
                "properties": {
                  "parameter": { "type": "integer", "minimum": 0 },
                  "execution": { "enum": ["inline", "tracked", "deferred"] },
                  "owner": {
                    "enum": ["inherited", "created", "unowned", "conditional", "leaf"]
                  },
                  "arguments": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        { "$ref": "#/$defs/return" },
                        { "type": "null" }
                      ]
                    }
                  },
                  "evidence": { "$ref": "#/$defs/claimEvidence" }
                }
              }
            },
            { "$ref": "#/$defs/unknownClaim" }
          ]
        },
        "ownerRequirements": {
          "oneOf": [
            {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["operation"],
                "properties": {
                  "operation": {
                    "enum": ["effect", "cleanup", "boundary", "settled-cleanup"]
                  },
                  "evidence": { "$ref": "#/$defs/claimEvidence" }
                }
              }
            },
            { "$ref": "#/$defs/unknownClaim" }
          ]
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["conditions", "summary"],
            "properties": {
              "conditions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "summary": { "$ref": "#/$defs/export" },
              "precedence": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "asyncBehavior": {
          "oneOf": [
            { "enum": ["promise", "async-iterable"] },
            { "$ref": "#/$defs/unknownClaim" }
          ]
        },
        "reactiveReads": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "label"],
                    "properties": {
                      "kind": { "enum": ["accessor", "store-path"] },
                      "label": { "type": "string", "minLength": 1 },
                      "evidence": { "$ref": "#/$defs/claimEvidence" }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "parameter"],
                    "properties": {
                      "kind": { "const": "parameter-member" },
                      "parameter": { "type": "integer", "minimum": 0 },
                      "evidence": { "$ref": "#/$defs/claimEvidence" }
                    }
                  }
                ]
              }
            },
            { "$ref": "#/$defs/unknownClaim" }
          ]
        }
      }
    },
    "unknownClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "const": "unknown" }
      }
    },
    "return": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "label"],
          "properties": {
            "kind": { "enum": ["accessor", "store-path"] },
            "label": { "type": "string", "minLength": 1 },
            "evidence": { "$ref": "#/$defs/claimEvidence" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "elements"],
          "properties": {
            "kind": { "const": "tuple" },
            "evidence": { "$ref": "#/$defs/claimEvidence" },
            "elements": {
              "type": "array",
              "minItems": 1,
              "items": {
                "anyOf": [
                  { "$ref": "#/$defs/return" },
                  { "type": "null" }
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "properties"],
          "properties": {
            "kind": { "const": "object" },
            "evidence": { "$ref": "#/$defs/claimEvidence" },
            "properties": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "minLength": 1 },
              "additionalProperties": { "$ref": "#/$defs/return" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "parameter"],
          "properties": {
            "kind": { "enum": ["argument", "callback-result"] },
            "parameter": { "type": "integer", "minimum": 0 },
            "evidence": { "$ref": "#/$defs/claimEvidence" }
          }
        }
      ]
    },
    "claimEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["inferred", "probed", "reviewed", "inherited-from"]
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "calls": { "type": "integer", "minimum": 1 },
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "probed" } } },
          "then": {
            "required": ["modes", "calls"],
            "not": { "anyOf": [{ "required": ["package"] }, { "required": ["version"] }] }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "inherited-from" } } },
          "then": {
            "required": ["package", "version"],
            "not": { "anyOf": [{ "required": ["modes"] }, { "required": ["calls"] }] }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "enum": ["inferred", "reviewed"] }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["modes"] },
                { "required": ["calls"] },
                { "required": ["package"] },
                { "required": ["version"] }
              ]
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}
