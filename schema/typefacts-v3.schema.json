{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solid-checker.dev/schema/typefacts-v3.schema.json",
  "title": "TypeFactsSchema v3 (retained lifecycle protocol)",
  "description": "Length-prefixed deterministic-CBOR request and response frames exchanged with solid-typefacts. Field names are the CBOR map keys. Optional fields are omitted, never null. The producer hashes this file and reports the digest in its startup handshake; both executables additionally ship in build-ID lockstep.",
  "oneOf": [
    { "$ref": "#/$defs/lifecycleRequest" },
    { "$ref": "#/$defs/lifecycleResponse" }
  ],
  "$defs": {
    "bytes": {
      "type": "string",
      "description": "CBOR byte string; JSON Schema has no byte-string type."
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "startByte", "endByte"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "startByte": { "type": "integer", "minimum": 0 },
        "endByte": { "type": "integer", "minimum": 0 }
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "location"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "location": { "$ref": "#/$defs/location" }
      }
    },
    "fileChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 0 },
        "source": { "$ref": "#/$defs/bytes" },
        "deleted": { "type": "boolean" }
      }
    },
    "entityDemand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location"],
      "properties": {
        "location": { "$ref": "#/$defs/location" },
        "queryLocation": { "$ref": "#/$defs/location" },
        "symbol": { "type": "boolean" },
        "typeDescriptor": { "type": "boolean" },
        "resolvedCall": { "type": "boolean" },
        "references": { "type": "boolean" },
        "async": { "type": "boolean" },
        "structuralAccessor": { "type": "boolean" }
      }
    },
    "compactDemands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groups", "strings"],
      "description": "Demand snapshot with one string dictionary per frame; index 0 is the empty string. Each group is [pathIndex, packedRows] where packedRows holds unsigned LEB128 (flags << 1 | hasQuery, startDelta, length) triples, each optionally followed by (queryPath, queryStart, queryLength).",
      "properties": {
        "groups": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              { "type": "integer", "minimum": 0 },
              { "$ref": "#/$defs/bytes" }
            ]
          }
        },
        "strings": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } }
      }
    },
    "lifecycleRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "requestId", "operation", "projectId", "generation"],
      "properties": {
        "schema": { "const": 3 },
        "requestId": { "type": "integer", "minimum": 1 },
        "operation": {
          "enum": ["open", "update", "analyze", "sources", "cancel", "close"]
        },
        "projectId": { "type": "string", "minLength": 1 },
        "generation": { "type": "integer", "minimum": 1 },
        "changes": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/fileChange" } },
        "demands": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/entityDemand" } },
        "compactDemands": { "$ref": "#/$defs/compactDemands" },
        "stateToken": { "type": "string" },
        "resetState": { "type": "boolean" },
        "removedDemandPaths": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } },
        "cancelRequestId": { "type": "integer", "minimum": 0 }
      }
    },
    "sourceDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "entityFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location"],
      "properties": {
        "location": { "$ref": "#/$defs/location" },
        "symbol": { "type": "string" },
        "typeDescriptor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": { "type": "string" },
            "originModule": { "type": "string" },
            "aliasDeclarations": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/declaration" } }
          }
        },
        "resolvedCall": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target": { "type": "string" },
            "returnTypeText": { "type": "string" }
          }
        }
      }
    },
    "symbolFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "description": "An alias symbol (aliasTarget non-empty) never carries references; the target owns them.",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "aliasTarget": { "type": "string" },
        "declarations": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/declaration" } },
        "references": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/location" } }
      }
    },
    "fileFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "calls": { "type": "array", "maxItems": 1000000 },
        "bindings": { "type": "array", "maxItems": 1000000 },
        "functions": { "type": "array", "maxItems": 1000000 },
        "asyncFunctions": { "type": "array", "maxItems": 1000000 }
      }
    },
    "factTableDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation"],
      "description": "Transforms the table named by the request's state token into the response generation. Collections stay canonically ordered after application.",
      "properties": {
        "generation": { "type": "integer", "minimum": 1 },
        "sources": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/sourceDigest" } },
        "removedSourcePaths": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } },
        "entityFiles": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "entities"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "entities": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/entityFact" } }
            }
          }
        },
        "removedEntityPaths": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } },
        "symbols": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/symbolFact" } },
        "removedSymbolIds": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } },
        "symbolReferenceFiles": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path"],
            "description": "Replaces one symbol's references within one source path. Every reference must lie in that path.",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "references": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/location" } }
            }
          }
        },
        "files": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/fileFact" } },
        "removedFilePaths": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } }
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyzeNs"],
      "properties": {
        "requestDecodeNs": { "type": "integer", "minimum": 0 },
        "analyzeNs": { "type": "integer", "minimum": 0 },
        "asyncNs": { "type": "integer", "minimum": 0 },
        "demandNs": { "type": "integer", "minimum": 0 },
        "assemblyNs": { "type": "integer", "minimum": 0 },
        "sortNs": { "type": "integer", "minimum": 0 },
        "closeSymbolsNs": { "type": "integer", "minimum": 0 },
        "materialized": { "type": "boolean" },
        "retainedFiles": { "type": "integer", "minimum": 0 },
        "recomputedFiles": { "type": "integer", "minimum": 0 },
        "nonDurableFiles": { "type": "integer", "minimum": 0 }
      }
    },
    "lifecycleResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "requestId", "projectId", "generation", "ok"],
      "description": "tableMode selects how the analyze result is carried: \"full\" ships packedTable, \"delta\" ships tableDelta, and \"reuse\" ships neither because the retained table is unchanged.",
      "properties": {
        "schema": { "const": 3 },
        "requestId": { "type": "integer", "minimum": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "generation": { "type": "integer", "minimum": 1 },
        "ok": { "type": "boolean" },
        "packedTable": {
          "$ref": "#/$defs/bytes",
          "description": "Opaque columnar fact-table frame. Its own leading version varint is the compatibility gate; see internal/typefacts/protocolv3_packed.go and crates/typefacts/src/v3.rs."
        },
        "tableDelta": { "$ref": "#/$defs/factTableDelta" },
        "tableMode": { "enum": ["full", "delta", "reuse"] },
        "stateToken": { "type": "string" },
        "affected": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } },
        "sources": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "source": { "$ref": "#/$defs/bytes" },
              "local": { "type": "boolean" }
            }
          }
        },
        "sourceArena": {
          "type": "string",
          "description": "Filesystem path to a temporary file holding every source body back to back, sliced by sourceLengths. Implies a producer and client that share a filesystem."
        },
        "sourceLengths": { "type": "array", "maxItems": 1000000, "items": { "type": "integer", "minimum": 0 } },
        "timings": { "$ref": "#/$defs/timings" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string" }
          }
        }
      }
    }
  }
}
