+/// V-D1: whether this call of an in-place method writes on every run. `sort`,
+/// `reverse`, `fill` and `copyWithin` read their length first: on a short array
+/// or an empty range they write nothing, and Chrome is silent. Only a literal
+/// the store provably still holds, with no elision, proves the length.
+fn mutator_always_writes(
+    file: &FileFacts,
+    context: &UpstreamCompatContext<'_>,
+    symbol: &crate::SymbolId,
+    call: &solid_facts::ast::CallFact,
+    method: &str,
+    callee: Span,
+    root: Span,
+) -> bool {
+    if !matches!(method, "sort" | "reverse" | "fill" | "copyWithin") {
+        return true;
+    }
+    let receiver = file
+        .ast
+        .member_at(callee)
+        .map(|member| file.ast.peel_ts_sugar_span(member.object));
+    let length = receiver
+        .and_then(|receiver| store_literal_at(file, context, symbol, receiver, root))
+        .and_then(|value| file.ast.array_literal_at(value))
+        .filter(|array| {
+            array
+                .elements
+                .iter()
+                .all(|element| element.kind == solid_facts::ast::ArrayElementKind::Value)
+        })
+        .map(|array| array.elements.len());
+    let Some(length) = length else {
+        return false;
+    };
+    let index = |argument: usize| {
+        call.arguments
+            .get(argument)
+            .and_then(|argument| file.source_text(argument.span))
+            .and_then(|text| text.parse::<usize>().ok())
+    };
+    match method {
+        "sort" | "reverse" => length >= 2,
+        "fill" => length >= 1 && call.arguments.len() == 1,
+        _ => {
+            call.arguments.len() == 2
+                && index(0).is_some_and(|target| target < length)
+                && index(1).is_some_and(|start| start < length)
+        }
+    }
+}
