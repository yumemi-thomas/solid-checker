+/// V-D1: a logical assignment `Set`s only when its test passes. The operator
+/// is the source between the target and the value, and the literal the store
+/// holds decides the test: anything else may skip the write, where Chrome is
+/// silent, so it proves nothing.
+fn logical_assignment_writes(
+    file: &FileFacts,
+    context: &UpstreamCompatContext<'_>,
+    symbol: &crate::SymbolId,
+    written: Span,
+    root: Span,
+) -> Option<bool> {
+    let assignment = file
+        .ast
+        .assignments
+        .iter()
+        .find(|assignment| file.ast.peel_ts_sugar_span(assignment.target) == written)?;
+    let between = file.source_text(Span::new(
+        assignment.target.end,
+        assignment.value_span.start,
+    ))?;
+    let operator = ["??=", "||=", "&&="]
+        .into_iter()
+        .find(|operator| between.contains(operator))?;
+    let writes = store_literal_at(file, context, symbol, written, root)
+        .and_then(|value| file.source_text(value))
+        .is_some_and(|text| {
+            let nullish = matches!(text, "null" | "undefined");
+            let falsy = nullish || matches!(text, "0" | "false" | "\"\"" | "''");
+            let known = falsy
+                || text == "true"
+                || text.parse::<f64>().is_ok()
+                || (text.len() > 2 && matches!(text.as_bytes()[0], b'"' | b'\''));
+            known
+                && match operator {
+                    "??=" => nullish,
+                    "||=" => falsy,
+                    _ => !falsy,
+                }
+        });
+    Some(writes)
+}
