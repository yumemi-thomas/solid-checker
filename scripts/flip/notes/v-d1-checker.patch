+/// The literal a proven store holds at `path` (a member chain from `root`, or
+/// `root`), read from its own initializer. Only ADR 0491's proof makes that the
+/// current value: nothing else can write the store, so the literal stands.
+fn store_literal_at(
+    file: &FileFacts,
+    context: &UpstreamCompatContext<'_>,
+    symbol: &crate::SymbolId,
+    member: Span,
+    root: Span,
+) -> Option<Span> {
+    if !links_proven_wrappable(file, context, member, root) {
+        return None;
+    }
+    let (_, declaration) = context.accessors.get(symbol)?;
+    if declaration.path.as_ref() != file.path.as_str() {
+        return None;
+    }
+    let binding = file.ast.bindings.iter().find(|binding| {
+        binding
+            .names
+            .iter()
+            .any(|name| u64::from(name.span.start) == declaration.start_byte)
+    })?;
+    let call = file.ast.call_at(binding.call_initializer?)?;
+    let mut value = file.ast.peel_ts_sugar_span(call.arguments.first()?.span);
+    let mut keys = Vec::new();
+    let mut link = file.ast.peel_ts_sugar_span(member);
+    while link != file.ast.peel_ts_sugar_span(root) {
+        let fact = file.ast.member_at(link)?;
+        keys.push(file.source_text(fact.property)?);
+        link = file.ast.peel_ts_sugar_span(fact.object);
+    }
+    for key in keys.iter().rev() {
+        value = file
+            .ast
+            .peel_ts_sugar_span(crate::execution_role::closed_literal_slot_value(
+                file, value, key,
+            )?);
+    }
+    Some(value)
+}
