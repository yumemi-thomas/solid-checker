    "dirfd:closed=real:stat:sibling.txt": {
      "errno": 8,
      "detail": "",
      "reason": "WASI-level, unchanged upstream: a closed fd is EBADF from fds.get; the host reference has no fd lifetime to compare."
    },
    "spot:setflags": {
      "errno": 52,
      "detail": "",
      "reason": "Unchanged upstream ABI: fd_fdstat_set_flags is ENOSYS, as the producer observes on every call."
