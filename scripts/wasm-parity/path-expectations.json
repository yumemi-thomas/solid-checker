    "dirfd:file=f:stat:x": {
      "errno": 76,
      "detail": "",
      "reason": "WASI-level, unchanged upstream: a regular-file fd lacks path rights, so fds.get answers ENOTCAPABLE before any path work (POSIX openat would say ENOTDIR)."
