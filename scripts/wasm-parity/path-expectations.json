      "errno": 44,
      "detail": "",
      "reason": "Go guest limitation: syscall/fs_wasip1.go appendCleanPath removes `..` lexically before any WASI call, so os.Stat asks for <root>/sibling.txt; no host layer can make this physical."
    },
    "mutation:7:unlink:f/": {
      "errno": 0,
      "detail": "check=missing",
      "reason": "Retained upstream mutation semantics: the final trailing slash is dropped (as upstream's lexical resolve dropped it) and only the parent is resolved physically; native POSIX unlink('f/') is ENOTDIR."
    }
