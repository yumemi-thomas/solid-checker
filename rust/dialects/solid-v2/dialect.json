{
  "schemaVersion": 1,
  "id": "solid-v2",
  "ruleManifest": "packages/cli/lib/rules-solid-v2.json",
  "contracts": [
    {
      "package": "solid-js",
      "packagePathEnv": "SOLID_V2_SOLID_JS_PACKAGE",
      "defaultPackagePath": "node_modules/solid-js",
      "generatorTarget": "solid-v2/solid-js",
      "reviewContract": "rust/crates/solid-dialect/contracts/solid-v2/solid-js.json",
      "exportsIndex": "rust/crates/solid-dialect/src/exports/solid_v2_solid_js.rs",
      "bundledContract": "pkg/contracts/bundled/solid-v2/solid-js.json",
      "probeRuntime": true
    },
    {
      "package": "@solidjs/web",
      "packagePathEnv": "SOLID_V2_SOLIDJS_WEB_PACKAGE",
      "defaultPackagePath": "node_modules/@solidjs/web",
      "generatorTarget": "solid-v2/solidjs-web",
      "reviewContract": "rust/crates/solid-dialect/contracts/solid-v2/solidjs-web.json",
      "exportsIndex": "rust/crates/solid-dialect/src/exports/solid_v2_solidjs_web.rs",
      "bundledContract": "pkg/contracts/bundled/solid-v2/solidjs-web.json",
      "probeRuntime": true
    }
  ]
}
