        "text": "import { createSignal } from \"solid-js\";\nconst [n] = createSignal(1);\nconst Comp = (props: { n: number }) => <button onClick={props.n} />;\nexport const Use = () => <Comp n={n()} />;\nexport default Comp;\n"
