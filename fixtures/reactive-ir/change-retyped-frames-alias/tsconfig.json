{
  "compilerOptions": {
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "target": "ES2022",
    "allowJs": true,
    "checkJs": false,
    "maxNodeModuleJsDepth": 1,
    "baseUrl": ".",
    "paths": {
      "@frames/client": [
        "./node_modules/@solidjs/web/frames/dist/client.js"
      ]
    }
  },
  "include": [
    "*.ts",
    "*.tsx"
  ]
}
