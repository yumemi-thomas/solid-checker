    "recipeSource": "// Pilot only: exact utils noop, no caller callbacks or objects supplied.\nimport { noop } from \"@solid-primitives/utils\";\nimport { DEV, createRoot, createEffect, getObserver, flush } from \"@solidjs/signals\";\n\nexport function observe(subject, harness) {\n  if (typeof DEV?.getSources !== \"function\") throw new Error(\"audited development observer unavailable\");\n  let dispose;\n  let calls = 0;\n  createRoot(cleanup => {\n    dispose = cleanup;\n    createEffect(() => {\n      calls += 1;\n      harness.emit({ marker: \"call\", kind: \"call\", phase: \"enter\" });\n      subject();\n      const observer = getObserver();\n      if (!observer) throw new Error(\"missing tracking observer\");\n      if (DEV.getSources(observer).length > 0) {\n        harness.emit({ marker: \"read-operation\", kind: \"call\", phase: \"enter\" });\n      }\n      harness.emit({ marker: \"call\", kind: \"call\", phase: \"exit\" });\n    }, () => {});\n  });\n  try {\n    flush();\n    if (calls !== 1) throw new Error(\"expected one completed synchronous invocation\");\n  } finally {\n    dispose();\n    flush();\n  }\n}\n\nexport async function runProbeSession(_session, harness) {\n  observe(noop, harness);\n}\n",
    "controlSource": "import { createSignal, untrack } from \"@solidjs/signals\";\nconst [privateSource] = createSignal(0);\nexport function trackedRead() { privateSource(); }\nexport function untrackedRead() { untrack(privateSource); }\n",
    "controlAuthority": "three fresh Node processes, not private certification-worker runs",
