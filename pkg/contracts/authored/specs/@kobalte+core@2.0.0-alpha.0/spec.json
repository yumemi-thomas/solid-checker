    "Root": {
      "why": "Hands every prop it does not consume to Polymorphic, which renders Dynamic with `as` (default \"button\"). With `as` absent or a tag name, Dynamic renders an element and the runtime's spread attaches every un-namespaced `on\u2026` prop as an event listener, invoked only when the event is dispatched. A component `as` receives every prop, so the claim is guarded on `as` being plain.",
      "rule": "strict-read-untracked",
      "scenario": [
        {
          "action": "click",
          "selector": "#target"
        },
        {
          "action": "wait-for-text",
          "selector": "#clicked",
          "text": "clicked"
        }
      ],
      "call": {
        "callbacks": [
          {
            "from": {
              "arg": 0,
              "path": [],
              "members": "event-handler-props"
            },
            "operation": "event-handlers"
          }
        ],
        "operations": [
          {
            "at": {
              "event": "external-event",
              "schedule": "external"
            },
            "count": {
              "max": "many",
              "min": 0,
              "scope": "call"
            },
            "guard": {
              "all": [
                {
                  "arg": 0,
                  "kind": "plain",
                  "path": [
                    "as"
                  ]
                }
              ]
            },
            "id": "event-handlers",
            "kind": "invoke",
            "tracking": "ambient-at-execution",
            "trigger": {
              "event": "external-event"
            }
          }
        ]
      }
    },
