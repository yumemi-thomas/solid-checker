{
  "package": "@tanstack/solid-query",
  "version": "6.0.0-rc.0",
  "solidRuntime": [
    {
      "name": "solid-js",
      "version": "2.0.0-rc.13",
      "integrity": "sha512-62bYOI4JZ15KOqL5eReKyWSwAXrGb0fbX8SDnHsbJk2UX+SzSyy1gobas2cxW/0BXcobGfQ1V6ffPyQkMIBdoQ=="
    },
    {
      "name": "@solidjs/signals",
      "version": "2.0.0-rc.13",
      "integrity": "sha512-4+pRdrAHtfyE9BUJWBup3TpzJojJjgW2mV1vm/Jik4tWa5epxXB/YrLkwqP1v8+S9XjyKKZu5BSLqmcpswMYeQ=="
    },
    {
      "name": "@solidjs/web",
      "version": "2.0.0-rc.13",
      "integrity": "sha512-vI/7v/XM8B/3U/oKAzCW2VjTLFkM5IArB2DFnrjxyPRYD3FX9KAXg9QuAnPIPQHC/xvg/LgxmvoVfZUfJ96gOQ=="
    }
  ],
  "exports": {
    "useMutation": {
      "why": "Returns a store of the mutation's state; reading a property untracked is a strict read.",
      "rule": "strict-read-untracked",
      "call": {
        "operations": [
          {
            "at": {
              "event": "call",
              "schedule": "same-stack"
            },
            "count": {
              "max": "many",
              "min": 0,
              "scope": "call"
            },
            "id": "return",
            "kind": "return",
            "output": {
              "kind": "store"
            },
            "tracking": "untracked",
            "trigger": {
              "event": "call"
            }
          }
        ],
        "returns": [
          "return"
        ]
      }
    }
  }
}
